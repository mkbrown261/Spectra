{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spectra",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spectra-production",
      "database_id": "f6f517a3-46eb-4837-bc84-9dbd4b61d66c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "spectra-assets"
    }
  ]
}
